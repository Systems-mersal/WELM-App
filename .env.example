# Tajeer Plus HTTP API (WELM)
# Local / staging: Tajeer Plus web origin (localhost or LAN IP).
# Store builds: https://www.mersal.com.sa
# Do not add EXPO_PUBLIC_SUPABASE_* — the app never talks to Supabase directly.
# Auth is Authorization: Bearer <accessToken> via Tajeer Plus.

EXPO_PUBLIC_API_URL=http://localhost:3000

# Set to false to block WELM auth HTTP calls with a clear error (no Supabase fallback).
# EXPO_PUBLIC_WELM_AUTH_ENABLED=false

# Optional: local Stripe PaymentIntent stub (`npm run server:dev` on :3001).
# Not the Tajeer Plus API — leave unset unless you run /server.
# EXPO_PUBLIC_PAYMENTS_API_URL=http://localhost:3001

# Google Sign-In (native). Leave empty until Cloud Console client IDs exist.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Stripe Dashboard → Developers → API keys → Publishable key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Apple Developer → Identifiers → Merchant IDs
# Must match app.json plugin merchantIdentifier and PaymentProvider
EXPO_PUBLIC_APPLE_MERCHANT_ID=merchant.com.welm.tajeerplus
