# Tajeer Plus API (WELM)
# Local: Tajeer Plus web origin (localhost or LAN IP).
# Store builds: https://www.mersal.com.sa
# Do not add EXPO_PUBLIC_SUPABASE_* — auth is Bearer via Tajeer Plus.

EXPO_PUBLIC_API_URL=http://localhost:3000

# Google Sign-In (native). Leave empty until Cloud Console client IDs exist.
# Do not invent IDs or secrets here.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# TODO: Stripe Dashboard → Developers → API keys → Publishable key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# TODO: Apple Developer → Identifiers → Merchant IDs
# Must match app.json plugin merchantIdentifier and PaymentProvider
EXPO_PUBLIC_APPLE_MERCHANT_ID=merchant.com.welm.tajeerplus

