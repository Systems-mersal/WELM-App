# Client (Expo) — copy to `.env` in the project root
# Never put Stripe *secret* keys here.

# Local payments stub (simulator). On a physical device use your Mac LAN IP, e.g. http://192.168.1.10:3001
EXPO_PUBLIC_API_URL=http://localhost:3001

# TODO: Stripe Dashboard → Developers → API keys → Publishable key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# TODO: Apple Developer → Identifiers → Merchant IDs
# Must match app.json plugin merchantIdentifier and PaymentProvider
EXPO_PUBLIC_APPLE_MERCHANT_ID=merchant.com.welm.tajeerplus
